# syntax=docker/dockerfile:1.12
FROM python:3.13-slim AS runtime-base

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

RUN useradd -m appuser

WORKDIR /app

ENV MARIMO_SKIP_UPDATE_CHECK=1 \
    UV_SYSTEM_PYTHON=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8080 \
    HOST=0.0.0.0

COPY --chown=appuser:appuser marimo/_tutorials tutorials
RUN rm -rf tutorials/__init__.py

EXPOSE $PORT

# Stage that carries the source tree for installs
FROM runtime-base AS source-base
COPY marimo /src/marimo
COPY pyproject.toml README.md LICENSE /src/

# ---- Slim variant ----
FROM source-base AS slim
RUN --mount=type=cache,target=/root/.cache/uv \
    cd /src && \
    uv pip install --no-cache-dir . && \
    rm -rf /src
USER appuser
CMD ["sh", "-c", "marimo edit --no-token -p $PORT --host $HOST"]

# ---- Data variant ----
FROM source-base AS data
RUN --mount=type=cache,target=/root/.cache/uv \
    cd /src && \
    uv pip install --no-cache-dir ".[recommended,lsp]" altair pandas numpy && \
    rm -rf /src
USER appuser
CMD ["sh", "-c", "marimo edit --no-token -p $PORT --host $HOST"]

# ---- SQL variant ----
FROM source-base AS sql
RUN --mount=type=cache,target=/root/.cache/uv \
    cd /src && \
    uv pip install --no-cache-dir ".[recommended,lsp,sql]" && \
    rm -rf /src
USER appuser
CMD ["sh", "-c", "marimo edit --no-token -p $PORT --host $HOST"]

# ---- Cloud variant (with FUSE-based cloud storage mounting) ----
FROM source-base AS cloud

# Install s3fs-fuse and dependencies for cloud storage mounting
RUN apt-get update && apt-get install -y --no-install-recommends \
    s3fs \
    fuse \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Allow non-root users to use FUSE
RUN echo "user_allow_other" >> /etc/fuse.conf

# Create mount point
RUN mkdir -p /acuity && chown appuser:appuser /acuity

# Install marimo with recommended packages plus cloud storage Python libraries
RUN --mount=type=cache,target=/root/.cache/uv \
    cd /src && \
    uv pip install --no-cache-dir ".[recommended,lsp,sql]" \
    s3fs fsspec gcsfs adlfs cloudpathlib boto3 && \
    rm -rf /src

# Copy entrypoint script
COPY --chmod=755 docker/entrypoint-cloud.sh /entrypoint.sh

# Environment variables for cloud storage configuration
ENV CLOUD_STORAGE_TYPE="" \
    CLOUD_STORAGE_BUCKET="" \
    CLOUD_STORAGE_MOUNT="/acuity" \
    CLOUD_STORAGE_OPTIONS=""

# Note: Running with FUSE requires --cap-add SYS_ADMIN --device /dev/fuse
# or --privileged flag when starting the container

USER appuser
ENTRYPOINT ["/entrypoint.sh"]
CMD ["sh", "-c", "marimo edit --no-token -p $PORT --host $HOST"]
